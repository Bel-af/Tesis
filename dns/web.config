<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>			
			<remove name="Python FastCGI" />			
            <add name="Python FastCGI" path="*" verb="*" modules="FastCgiModule" scriptProcessor="C:\Python314\python.exe|C:\Python314\Lib\site-packages\wfastcgi.py" resourceType="Unspecified" requireAccess="Script" />		
        </handlers>
    </system.webServer>
	
	<appSettings>       
       <add key="WSGI_HANDLER" value="application.app" />
       <add key="PYTHONPATH" value="C:\inetpub\wwwroot\dns\" />
     </appSettings>		
</configuration>
